# Supabase — use the SHARED POOLER (Supavisor) host, NOT the direct connection.
# config.py rewrites postgresql:// -> postgresql+asyncpg:// and strips ?sslmode=.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Microsoft Foundry (via OpenAI SDK): point base_url at the Foundry endpoint.
FOUNDRY_BASE_URL=
FOUNDRY_API_KEY=
FOUNDRY_MODEL=

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=

# Shared API key for dashboard calls (single-tenant demo auth)
API_KEY=

# CORS origin for the Vercel frontend
CORS_ORIGINS=http://localhost:5173
