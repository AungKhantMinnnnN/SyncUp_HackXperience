# Supabase — use the SHARED POOLER (Supavisor) host, NOT the direct connection.
# config.py rewrites postgresql:// -> postgresql+asyncpg:// and strips ?sslmode=.
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:5432/postgres

# Microsoft Foundry (via Azure AI Projects SDK). Auth is Entra ID, NOT an API key:
#   local dev -> `az login`   ·   Render -> set AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET
# Endpoint is the project endpoint; calls reference the hosted agent by name + version.
FOUNDRY_PROJECT_ENDPOINT=https://<resource>.services.ai.azure.com/api/projects/<project>
FOUNDRY_AGENT_NAME=SyncUp-Agent
FOUNDRY_AGENT_VERSION=1

# Discord bot
DISCORD_BOT_TOKEN=
DISCORD_TEST_GUILD_ID=

# The single organization this deployment serves. Seed creates the org with this id.
# Leave as-is unless you re-seed with a different id.
ORG_ID=11111111-1111-1111-1111-111111111111

# Shared API key for dashboard calls (single-tenant demo auth)
API_KEY=

# CORS origin for the Vercel frontend
CORS_ORIGINS=http://localhost:5173
